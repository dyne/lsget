# Copy to .env for docker-compose.yaml. The standalone binary reads its
# process environment. For native service defaults, see deploy/QUICKSTART.md.

# Server Configuration
# --------------------

# Listener inside the container. Standalone default: localhost:8080.
LSGET_ADDR=0.0.0.0:8080

# Served directory inside the container. Standalone default: current directory.
LSGET_DIR=/data

# Maximum bytes for cat and its completion suggestions. Default: 4096 (4 KiB).
LSGET_CATMAX=4096

# Compose passes this value to lsget as LSGET_BASEURL. Use an absolute HTTP(S)
# URL without credentials, query or fragment, e.g. https://files.example.com.
# Leave empty to derive share links from the request and use a manual sitemap.
SERVICE_URL_LSGET=

# Logging Configuration
# ---------------------

# Writable access log inside the container. Compose uses the path below when
# this value is empty. Standalone defaults to request logging on stdout only.
LSGET_LOGFILE=/logs/access.log

# Process Management
# ------------------

# Optional application PID file. Use a writable directory outside /data.
LSGET_PID=

# Sitemap Generation
# ------------------

# Refresh the in-memory sitemap every N minutes when a public URL is set.
# With 0, generate on the first successful request and cache until restart.
LSGET_SITEMAP=0
