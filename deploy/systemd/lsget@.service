[Unit]
Description=lsget - Web-based terminal file server (%i)
Documentation=https://github.com/dyne/lsget
After=network.target

[Service]
Type=simple
User=lsget
Environment=LSGET_ADDR=127.0.0.1:8037 LSGET_DIR=/srv/ftp LSGET_LOGFILE=/var/log/lsget/access-%i.log
EnvironmentFile=-/etc/default/lsget-%i
EnvironmentFile=-/etc/sysconfig/lsget-%i
# Preserve the legacy recipe's PID setting when LSGET_PID is absent.
ExecStart=/bin/sh -ec 'LSGET_PID="$${LSGET_PID-$${LSGET_PIDFILE:-}}" exec /usr/local/bin/lsget'
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lsget /var/log/lsget
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateMounts=true

# Working directory
WorkingDirectory=/var/lib/lsget

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
