# Configuration for lsget service
# /etc/conf.d/lsget
# OpenRC sources this file before the service script.
# shellcheck disable=SC2034

# Listen address (IP:PORT)
# Default: 127.0.0.1:8037
LSGET_ADDR="127.0.0.1:8037"

# Root directory to serve
# Default: /srv/ftp
# Note: This directory must be readable by the lsget user
LSGET_DIR="/srv/ftp"

# Maximum bytes printable via 'cat' command and used by completion (4 KiB).
LSGET_CATMAX="4096"

# Access log. Defaults to lsget.log or lsget.INSTANCE.log in /var/log/lsget.
# Set an empty value to disable the file log.
# LSGET_LOGFILE="/var/log/lsget/lsget.log"

# Optional application PID file, separate from OpenRC's supervisor PID file.
# Use a unique path per instance if you set this.
# LSGET_PID="/var/lib/lsget/lsget.pid"

# Public URL for canonical tags, sitemaps, origin checks and url/share commands.
# LSGET_BASEURL="https://files.example.com"

# Optional metadata for the embedded terminal.
# LSGET_SITE_TITLE="Release files"
# LSGET_SITE_DESCRIPTION="Browse releases and download checksums."
# LSGET_PREVIEW_IMAGE="https://files.example.com/preview.png"

# In-memory sitemap refresh interval in minutes (0 = on demand only).
# LSGET_SITEMAP="0"

# HTTPS-only proxy settings. Use the CIDR of the proxy's actual peer address.
# LSGET_SECURE_SESSION_COOKIE="true"
# LSGET_TRUSTED_PROXIES="127.0.0.1/32"

# Additional command line options (optional)
# LSGET_OPTS=""
