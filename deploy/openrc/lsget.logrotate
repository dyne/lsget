# Logrotate configuration for lsget
# Install to: /etc/logrotate.d/lsget

/var/log/lsget/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create
}

# OpenRC keeps these output files open while lsget runs.
/var/log/lsget/*.out /var/log/lsget/*.err {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    copytruncate
}
